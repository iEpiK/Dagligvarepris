# Postgres
POSTGRES_USER=grocery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=grocery
DATABASE_URL=postgresql://grocery:change-me@postgres:5432/grocery

# Backend
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
# Hvor ofte (cron) skal vi forsøke å synke kvitteringer for tilkoblede brukere
SYNC_CRON=0 */6 * * *

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
